{
  "name": "Fastr",

  // Requirement 20.4. Node 22 matches CI and the Dockerfile's build stage; a dev container on a different major
  // version is a way to find out in CI that something works locally and nowhere else.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",

  "features": {
    // The Supabase CLI runs the local stack in containers, so the dev container needs a runtime of its own. Without
    // this, `npm run setup` fails inside the container with the same "no container runtime" message it gives on a bare
    // machine.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },

  // 5173 is Vite. The rest are the local Supabase ports worth having forwarded: the API gateway, Postgres itself for a
  // database client, Studio, and the mail catcher that receives invite and reset emails.
  "forwardPorts": [5173, 54321, 54322, 54323, 54324],
  "portsAttributes": {
    "5173": { "label": "Fastr", "onAutoForward": "notify" },
    "54321": { "label": "Supabase API" },
    "54322": { "label": "Postgres" },
    "54323": { "label": "Supabase Studio" },
    "54324": { "label": "Mail (invites, resets)" }
  },

  // Dependencies only. `npm run setup` is left to the developer rather than run here: it pulls a dozen container
  // images, and doing that unasked on first open makes a container that appears to hang for several minutes.
  "postCreateCommand": "npm ci",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "supabase.vscode-supabase-extension"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },

  // The Supabase CLI writes into the workspace and needs to own what it writes.
  "remoteUser": "node"
}
