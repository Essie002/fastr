{
  "name": "fastr",
  "version": "0.1.0",
  "private": true,
  "description": "Fastr \u2014 intermittent fasting tracker. Pick a plan, start a fast, get told when it's done.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "packages/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @fastr/web",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview --workspace @fastr/web",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "setup": "node scripts/setup.mjs",
    "db:start": "node scripts/supabase.mjs start",
    "db:stop": "node scripts/supabase.mjs stop",
    "db:reset": "node scripts/supabase.mjs db reset",
    "db:status": "node scripts/supabase.mjs status",
    "db:psql": "node scripts/psql.mjs",
    "gen:stages": "node --experimental-strip-types scripts/gen-stages.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "send:notifications": "node scripts/send-notifications.mjs",
    "check:rls": "node scripts/check-rls.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@supabase/supabase-js": "2.117.2",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.3.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "supabase": "2.118.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
