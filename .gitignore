node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/

# Secrets. `.env.example` is the one that is committed, and holds placeholders only.
.env
.env.*
!.env.example

# Written by `npm run setup` from `supabase status`, so it is generated, not authored.
packages/web/.env.local

# Supabase CLI working directories.
supabase/.branches/
supabase/.temp/

# Written by `npm run setup`: the container socket this machine happens to use. Machine-specific,
# so it is generated rather than committed.
.docker-host

# Local Edge Function secrets, written by `npm run setup`. The committed file is `.env.example`.
supabase/functions/.env

.DS_Store
# The hosted project's Postgres password, written by the deploy. Never committed.
.supabase-db-password
# Netlify site id, written during deployment. Not secret, but machine-specific.
.netlify-site-id
.netlify/
