# Secrets for locally served Edge Functions.
#
# The Supabase CLI passes this file's contents to the local edge runtime. `npm run setup` writes a real
# `supabase/functions/.env` beside this one, with a freshly generated VAPID pair and a fixed local cron secret, so
# local development works without anyone pasting keys about.
#
# In the hosted project none of this file is used. Secrets go in with:
#
#   npx supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=... CRON_SECRET=...
#
# The local values below are development-only and deliberately boring. Do not reuse them anywhere real.

# Proves a request to send-notifications came from the cron job rather than from the internet.
CRON_SECRET=local-cron-secret

# Web Push signing keys. Generate a real pair with `npm run gen:vapid`.
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_SUBJECT=mailto:you@example.com
