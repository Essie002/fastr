# Fastr environment. Copy to `.env` and fill in. Placeholders only in this file — never a real key.
#
# For local development you do not need to copy this at all: `npm run setup` writes
# `packages/web/.env.local` from the local Supabase stack. This file documents the hosted setup.

# ---------------------------------------------------------------------------
# Web app (baked into the bundle by Vite at build time — both are public)
# ---------------------------------------------------------------------------

# The Supabase project URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon key. Public by design: it identifies the project, and Row Level Security is what
# keeps one user out of another's rows. Safe in a bundle and in a public repo.
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Edge Function secrets (set with `supabase secrets set`, never committed, never in the bundle)
# ---------------------------------------------------------------------------

# Bypasses Row Level Security completely. If this ever reaches a browser, every user's data is
# readable by every other user.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push signing keys from `npm run gen:vapid`. The public half also goes in the web app;
# the private half belongs here and nowhere else.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Shared secret proving a request to `send-notifications` came from the cron job. Cron has no
# user, so there is no JWT to verify and this takes its place.
CRON_SECRET=a-long-random-string

# ---------------------------------------------------------------------------
# CI / deployment (GitHub Actions secret, in a protected environment)
# ---------------------------------------------------------------------------

# Used by the manual deploy workflow for `supabase db push` and `functions deploy`.
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
